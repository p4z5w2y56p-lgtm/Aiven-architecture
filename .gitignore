# Python
__pycache__/
*.py[cod]
.venv/

# Tool caches and reports
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build output
build/
dist/
*.egg-info/

# Terraform: the providers it downloads, and state and plans, never go into Git. The state lives in
# its bucket in the control project; .terraform.lock.hcl is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# The zips of the functions that Terraform builds.
.build/

# The one-click apply of M2: its Terraform, plans, plugin cache, state and log (scripts/m2-oneclick.sh).
.m2-oneclick/
